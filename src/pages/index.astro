---
import SocialList from "@/components/SocialList.astro";
import { featuredProjects, projects } from "@/data/projects";
import PageLayout from "@/layouts/Base.astro";
---

<PageLayout meta={{ title: "Home" }}>
	<section>
		<h1 class="title mb-6">Manas Ganti</h1>
		<p class="mb-4">
			I build reinforcement learning environments for LLM and vision-language agents across
			domains: medical diagnosis, image forensics, and long-document reasoning. I also build the
			evals that grade them and the AI engineering around them, from a coding-agent test harness to
			tool-calling LLM applications.
		</p>
		<p class="mb-6">
			I'm doing my M.S. in Computer Engineering at Virginia Tech (graduating May 2027). Before that,
			I spent two and a half years shipping computer vision models into clinical imaging and edge
			deployments. <a class="cactus-link" href="/about/">More about me</a>.
		</p>
		<SocialList />
	</section>

	<section class="mt-16">
		<h2 class="title mb-6 text-xl">Selected work</h2>
		<ul class="space-y-6" role="list">
			{
				featuredProjects.map((p) => (
					<li>
						<a class="cactus-link font-semibold" href={`/projects/#${p.slug}`}>
							{p.title}
						</a>
						<p class="mt-1">{p.summary ?? p.tagline}</p>
					</li>
				))
			}
		</ul>
		<p class="mt-8">
			<a class="cactus-link" href="/projects/">All {projects.length} projects →</a>
		</p>
	</section>
</PageLayout>
