---
import ProjectCard from "@/components/ProjectCard.astro";
import { areaBlurb, areaLabel, type ProjectArea, projects, statusLabel } from "@/data/projects";
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description:
		"Reinforcement learning environments, post-training experiments, and production ML systems — each with its design decision, its status, and its code.",
	title: "Projects",
};

const areas: ProjectArea[] = ["llm-rl", "optimum", "embodied", "systems"];

const statusDot: Record<(typeof projects)[number]["status"], string> = {
	shipped: "bg-accent",
	training: "bg-link",
	design: "bg-muted",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-6">Projects</h1>

	<p class="mb-4">
		I build RL environments and ML systems, and most of the work goes into making sure the final
		number is true. I check the data for shortcuts before training, write pass/fail gates before
		the run, and compute a ceiling the model shouldn't be able to beat. Every number here is
		measured and points to the file it came from. Results that went against me stay in, with the
		reason.
	</p>
	<p class="text-muted mb-12 text-xs">
		All {projects.length}, grouped by what they show, with the four I'd start with already open. Each
		card covers the <span class="text-accent-2 font-semibold">Approach</span>, then
		<span class="text-accent-2 font-semibold">What I found</span>.
	</p>

	<section>
		<p class="text-muted mb-8 text-sm">
			Open a row for the full card.
			<span class="ms-2 inline-flex flex-wrap items-center gap-x-3">
				{
					(["shipped", "training", "design"] as const).map((s) => (
						<span class="inline-flex items-center gap-x-1 text-xs">
							<span aria-hidden="true" class:list={["inline-block h-2 w-2 rounded-full", statusDot[s]]} />
							{statusLabel[s]}
						</span>
					))
				}
			</span>
		</p>
		{
			areas.map((area) => {
				const group = projects.filter((p) => p.area === area);
				return (
					<div class="mb-12">
						<h3 class="text-accent-2 text-lg font-semibold">{areaLabel[area]}</h3>
						<p class="text-muted mb-4 text-sm">{areaBlurb[area]}</p>
						<ul class="divide-muted/30 border-muted/30 divide-y border-y" role="list">
							{group.map((p) => (
								<li>
									<details class="group py-3" id={p.slug} open={p.featured}>
										<summary class="cursor-pointer list-none">
											<span class="flex items-baseline gap-x-2">
												<span
													aria-label={statusLabel[p.status]}
													class:list={["inline-block h-2 w-2 shrink-0 rounded-full", statusDot[p.status]]}
													role="img"
												/>
												<span class="font-semibold">{p.title}</span>
												<span aria-hidden="true" class="text-muted ms-auto text-xs group-open:rotate-90">
													▸
												</span>
											</span>
											<span class="text-muted mt-1 block ps-4 text-sm">{p.brief}</span>
										</summary>
										<div class="ps-4">
											<ProjectCard nested project={p} />
										</div>
									</details>
								</li>
							))}
						</ul>
					</div>
				);
			})
		}
	</section>

	<script>
		// Rows are collapsed <details>; open the one a link points at (e.g. /projects/#arcode).
		function openFromHash() {
			const el = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
			if (el instanceof HTMLDetailsElement) {
				el.open = true;
				el.scrollIntoView();
			}
		}
		openFromHash();
		window.addEventListener("hashchange", openFromHash);
	</script>
</PageLayout>
