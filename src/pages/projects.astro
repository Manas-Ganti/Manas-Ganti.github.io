---
import ProjectCard from "@/components/ProjectCard.astro";
import { areaLabel, type ProjectArea, projects } from "@/data/projects";
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description:
		"Reinforcement learning environments, post-training experiments, and production ML systems — each with its design decision, its status, and its code.",
	title: "Projects",
};

const areas: ProjectArea[] = ["rl", "systems"];
---

<PageLayout meta={meta}>
	<h1 class="title mb-6">Projects</h1>

	<p class="mb-4">
		Where a number appears, it was measured and you can check it in the repo. Several of these RL
		projects have been trained and didn't work the way I hoped. Those results are here too, with the
		reason, because a negative result I can explain is worth more than a positive one I can't.
		Projects that haven't been trained yet say so and show no number.
	</p>
	<p class="text-muted mb-12 text-xs">
		What I think is worth reading in each one is the design decision, not the tech stack. Those are
		under <span class="text-accent-2 font-semibold">The hard part</span>.
	</p>

	{
		areas.map((area) => (
			<section class="mb-16">
				<h2 class="title mb-6 text-xl">{areaLabel[area]}</h2>
				<div class="space-y-12">
					{projects
						.filter((p) => p.area === area)
						.map((project) => (
							<ProjectCard project={project} />
						))}
				</div>
			</section>
		))
	}
</PageLayout>
